# OPTIONAL. Enables Google Cloud Vision OCR and Google Cloud Translation.
# Requires an enabled Google Cloud project and billing, plus both APIs enabled.
# Never commit real keys. No key = local OCR only.
GOOGLE_CLOUD_API_KEY=

# OPTIONAL: For downloaded tessdata_best models (./scripts/enable-best-models.sh)
# TESSDATA_PREFIX=/models

# OPTIONAL no-cloud translation on your Mac using Ollama: install Ollama first,
# run `ollama pull gemma3:4b`, then uncomment below. Test quality carefully.
# OLLAMA_MODEL=gemma3:4b
# OLLAMA_URL=http://host.docker.internal:11434
# TRANSLATION_PROVIDER=ollama

# Local-only by default. Set a strong API key behind an HTTPS reverse proxy before public deployment.
OCR_MAX_CONCURRENT=2
API_REQUESTS_PER_MINUTE=30
MYAN_OCR_API_KEY=

# Safe for Docker loopback port 127.0.0.1 ONLY. Set 0 for any remote deployment.
MYAN_OCR_LOCAL_DEV=1
MYAN_OCR_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
OCR_JOB_DEADLINE_SECONDS=75
